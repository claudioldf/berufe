# Runtime selection
BERUFE_ENV=local
RAILS_ENV=development
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=berufe_development
POSTGRES_USER=berufe
POSTGRES_PASSWORD=berufe_local_only
DATABASE_URL=postgresql://berufe:berufe_local_only@db:5432/berufe_development
TEST_DATABASE_URL=postgresql://berufe:berufe_local_only@db:5432/berufe_test
RAILS_MAX_THREADS=5
DB_POOL=5

# Application URLs; only NUXT_PUBLIC_* values may enter the browser bundle
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
OPENAPI_CONTRACT_PATH=/contracts/openapi.yaml
NUXT_API_INTERNAL_BASE_URL=http://api:3000
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Signs generated Open Graph image URLs. Optional locally (the module
# generates one at build time); staging/production on more than one
# instance need a fixed value here so every instance signs the same way.
NUXT_OG_IMAGE_SECRET=

# Growth reporting. Staging and production must set the real launch date.
PRODUCT_LAUNCH_DATE=2026-08-01

# Non-production administrator seed (the service refuses production execution)
ADMIN_AUTH_EMAIL=admin@berufe.com.br
ADMIN_AUTH_PASSWORD=@Qwer1234

# Service adapters
# Safe local default. Set to infobip only after configuring the restricted
# integration credentials and allowlist below.
SMS_OTP_ADAPTER=fake
FAKE_SMS_OTP_CODE=123456
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_DAILY_PHONE_LIMIT=5
OTP_DAILY_IP_LIMIT=20
OTP_CHALLENGE_TTL_SECONDS=600
SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=300
MEDIA_STORAGE_ADAPTER=local
LOCAL_STORAGE_ROOT=/app/storage/berufe

# Public expression search parser. Local uses fake; staging/integration/production use openai.
LLM_ADAPTER=fake
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=8
OPENAI_API_KEY=

# Approximate visitor location (server-only; required in staging/integration/production)
# Use GeoLite web services credentials. Never expose these as NUXT_PUBLIC_* values.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Recommendation email (required in staging, integration, and production).
# Local/development mail is unrelated to these: it always goes through
# MailCatcher (compose.yaml, UI at http://localhost:1080). Override
# MAILER_SMTP_HOST/MAILER_SMTP_PORT only for a host-run `bin/rails server`
# pointed at a different local MailCatcher instance.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=berufe.com.br
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true
MAIL_FROM=Berufe <nao-responda@berufe.com.br>

# GoodJob
GOOD_JOB_EXECUTION_MODE=external
GOOD_JOB_MAX_THREADS=2
GOOD_JOB_QUEUES=default
GOOD_JOB_PROBE_PORT=7001

# Infobip 2FA (server-only; required when SMS_OTP_ADAPTER=infobip)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
INFOBIP_SENDER=
INFOBIP_REQUEST_TIMEOUT_SECONDS=5
# Local, staging, and integration use a dedicated integration profile and allowlist.
INFOBIP_CREDENTIAL_SCOPE=integration
INFOBIP_TEST_NUMBERS=

# Cloudflare R2 (server-only; required for staging/integration/production)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=berufe-public-media
R2_PRIVATE_BUCKET=berufe-private-media

# Deployment secrets and error reporting (server-only)
# SECRET_KEY_BASE=required-in-staging-integration-production
BUGSNAG_API_KEY=
# Browser notifier key is public by design; use a separate Bugsnag web project.
NUXT_PUBLIC_BUGSNAG_API_KEY=
