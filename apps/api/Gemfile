source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "8.1.3.1"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Validate the Rails HTTP boundary against the shared OpenAPI document
gem "openapi_first", "~> 3.4"
# Allow credentialed browser requests only from the configured Nuxt origin
gem "rack-cors", "~> 3.0"
# Store production media in Cloudflare R2 through its S3-compatible API
gem "aws-sdk-s3", "~> 1.0"
# Decode, orient, sanitize, and re-encode uploaded images outside request threads
gem "ruby-vips", "~> 2.2"
# Run Active Job work in PostgreSQL
gem "good_job", "~> 4.0"
# Enforce role, ownership, and public-data authorization at the API boundary
gem "pundit", "~> 2.5"
# Parse public search expressions through the OpenAI Responses API.
gem "openai", "~> 0.80.0"
# Resolve an approximate city/UF from the visitor IP without exposing provider credentials.
gem "maxmind-geoip2", "~> 1.6"
# Import the official IBGE neighborhood DBF archives.
gem "rubyzip", "~> 3.5"
gem "dbf", "~> 5.4"

# Hash administrator passwords through Active Model's secure-password support
gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[windows jruby]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Enforce the repository's Ruby style without a separate RuboCop configuration
  gem "standard", "1.56.0", require: false

  # Test application behavior with RSpec
  gem "rspec-rails", "~> 8.0"
end

gem "bugsnag", "~> 6.30"
