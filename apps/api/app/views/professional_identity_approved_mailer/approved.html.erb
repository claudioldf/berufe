<h1 class="email-title" style="margin: 0 0 20px; color: #17352f; font-size: 36px; line-height: 1.15; letter-spacing: -0.03em;">
  Identidade verificada, <%= @display_name %>!
</h1>

<p style="margin: 0 0 22px;">
  A equipe da Berufe analisou e aprovou a verificação de identidade do seu perfil.
</p>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#17352f" style="width: 100%; border-radius: 20px; background-color: #17352f;">
  <tr>
    <td style="padding: 24px;">
      <p style="margin: 0 0 7px; color: #ff9a85; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">Verificação aprovada</p>
      <p style="margin: 0 0 7px; color: #ffffff; font-size: 24px; font-weight: 700; line-height: 1.25;">Mais confiança para seus clientes.</p>
      <p style="margin: 0 0 20px; color: #cfe4dc; font-size: 14px; line-height: 1.55;">Seu perfil agora mostra o selo de identidade verificada.</p>

      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="width: 100%; border-radius: 16px; background-color: #ffffff;">
        <tr>
          <td width="62" valign="middle" style="width: 62px; padding: 17px 0 17px 18px;">
            <table role="presentation" width="42" height="42" cellspacing="0" cellpadding="0" border="0" bgcolor="#dff1eb" style="width: 42px; height: 42px; border-radius: 12px; background-color: #dff1eb;">
              <tr>
                <td align="center" valign="middle" style="color: #12625d; font-size: 23px; font-weight: 700; line-height: 42px;">✓</td>
              </tr>
            </table>
          </td>
          <td valign="middle" style="padding: 17px 18px 17px 12px;">
            <p style="margin: 0 0 4px; color: #17352f; font-size: 16px; font-weight: 700;">Identidade verificada</p>
            <p style="margin: 0; color: #526963; font-size: 14px; line-height: 1.5;">Aprovada pela equipe da Berufe.</p>
          </td>
        </tr>
      </table>

      <table role="presentation" align="center" cellspacing="0" cellpadding="0" border="0" style="margin: 20px auto 0;">
        <tr>
          <td align="center" bgcolor="#ffffff" style="border-radius: 12px; background-color: #ffffff;">
            <a class="email-button" href="<%= @profile_url %>" style="display: inline-block; padding: 14px 24px; color: #17352f; font-weight: 700; text-decoration: none;">
              Ver meu perfil público
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 28px 0 0; color: #61736d; font-size: 14px;">
  Seu perfil público: <a href="<%= @profile_url %>" style="color: #17352f;"><%= @profile_url %></a>
</p>
